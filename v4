class _TotalVivosCell extends StatelessWidget {
  final String eventoId; final Color acento;
  const _TotalVivosCell({required this.eventoId, required this.acento});
  Stream<Map<String, int>> _stream() async* {
    yield* FirebaseFirestore.instance.collection('eventos')
        .doc(eventoId).snapshots().asyncMap((eSnap) async {
      final mSnap = await FirebaseFirestore.instance.collection('eventos')
          .doc(eventoId).collection('mesas').get();
      int vivos = 0;
      for (final m in mSnap.docs) {
        final a = await m.reference.collection('jugadores_activos').get();
        vivos += a.docs.length;
      }
      final ed = eSnap.data() as Map<String, dynamic>? ?? {};
      return {'vivos': vivos, 'total': (ed['jugadores_ids'] as List?)?.length ?? 0};
    });
  }
  @override
  Widget build(BuildContext context) => StreamBuilder<Map<String, int>>(
    stream: _stream(),
    builder: (_, snap) {
      final v = snap.data?['vivos'] ?? 0;
      final t = snap.data?['total'] ?? 0;
      return Container(width: double.infinity,
        padding: const EdgeInsets.symmetric(vertical: 7),
        decoration: const BoxDecoration(border: Border(bottom: BorderSide(color: Colors.white12))),
        child: Column(children: [
          const Text("Vivos / Total", style: TextStyle(color: Colors.white54,
            fontSize: 11, fontWeight: FontWeight.w600, letterSpacing: 1)),
          Text("$v / $t", style: TextStyle(color: acento, fontSize: 18, fontWeight: FontWeight.w900)),
          if (t > 0) Text("${t - v} eliminados",
            style: const TextStyle(color: Colors.white38, fontSize: 9)),
        ]));
    });
}

