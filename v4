// -- Franja ciudades -----------------------------------------
class _FranjaCiudades extends StatelessWidget {
  final String eventoId; final Color acento;
  final bool mostrarClubes; final VoidCallback onToggleClubes;
  const _FranjaCiudades({required this.eventoId, required this.acento,
    required this.mostrarClubes, required this.onToggleClubes});

  Stream<Map<String, Set<String>>> _getData() async* {
    yield* FirebaseFirestore.instance.collection('eventos')
        .doc(eventoId).collection('mesas').snapshots().asyncMap((snap) async {
      Map<String, Set<String>> ciudades = {};
      for (final m in snap.docs) {
        final aSnap = await m.reference.collection('jugadores_activos').get();
        for (final j in aSnap.docs) {
          final d  = j.data() as Map<String, dynamic>;
          final c  = d['ciudad']?.toString().trim() ?? '';
          final cl = d['club']?.toString().trim()   ?? '';
          if (c.isNotEmpty) { ciudades[c] ??= {}; if (cl.isNotEmpty) ciudades[c]!.add(cl); }
        }
      }
      return ciudades;
    });
  }

  @override
  Widget build(BuildContext context) => StreamBuilder<Map<String, Set<String>>>(
    stream: _getData(),
    builder: (_, snap) {
      final data = snap.data ?? {};
      if (data.isEmpty) return const SizedBox(height: 32,
        child: Center(child: Text("Sin ciudades", style: TextStyle(color: Colors.white24, fontSize: 11))));
      return Container(height: 36, color: Colors.black54,
        child: Row(children: [
          Expanded(child: SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            child: Row(children: [
              const Padding(padding: EdgeInsets.symmetric(horizontal: 12),
                child: Icon(Icons.location_on, color: Colors.white54, size: 14)),
              ...data.entries.map((e) => Padding(
                padding: const EdgeInsets.symmetric(horizontal: 10),
                child: Column(mainAxisAlignment: MainAxisAlignment.center,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text("?? ${e.key}", style: TextStyle(color: acento,
                      fontSize: 12, fontWeight: FontWeight.bold)),
                    if (mostrarClubes && e.value.isNotEmpty)
                      Text(e.value.join(" · "),
                        style: const TextStyle(color: Colors.white54, fontSize: 9)),
                  ]))),
            ]))),
          if (sesionActual.puedeEditarAlgo)
            GestureDetector(onTap: onToggleClubes,
              child: Container(padding: const EdgeInsets.symmetric(horizontal: 10),
                child: Icon(mostrarClubes ? Icons.groups : Icons.groups_outlined,
                  color: mostrarClubes ? acento : Colors.white38, size: 20))),
        ]));
    });
}

