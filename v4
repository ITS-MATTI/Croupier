class _CajaJornadaScreen extends StatefulWidget {
  final String docId;
  final _Jornada jornada;
  const _CajaJornadaScreen({required this.docId, required this.jornada});
  @override State<_CajaJornadaScreen> createState() => _CajaJornadaState();
}
class _CajaJornadaState extends State<_CajaJornadaScreen>
    with SingleTickerProviderStateMixin {
  late _Jornada j;
  late TabController _tab;
  bool _guardando = false;

  @override
  void initState() {
    super.initState();
    j = widget.jornada;
    _tab = TabController(length: 6, vsync: this);
  }
  @override void dispose() { _tab.dispose(); super.dispose(); }

  Future<void> _guardar() async {
    setState(() => _guardando = true);
    // Recalcular diferencia y staff subtotales antes de guardar
    for (final s in j.staff) {
      final prop  = (s['propinas'] ?? 0.0) as double;
      final jorn  = (s['jornada']  ?? 0.0) as double;
      final extra = (s['hExtras']  ?? 0.0) as double;
      final abono = (s['abono']    ?? 0.0) as double;
      s['subtotal']  = prop + jorn + extra;
      s['porPagar']  = (prop + jorn + extra) - abono;
    }
    j.diferencia = j.entregadas - j.recibidas - j.casilla - j.propinas;
    await FirebaseFirestore.instance.collection('jornadas').doc(widget.docId)
        .update(j.toMap());
    setState(() => _guardando = false);
    if (mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
      content: Text("? Guardado", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold)),
      backgroundColor: verdeNeon, duration: Duration(seconds: 1)));
  }

  // -- helpers de input --
