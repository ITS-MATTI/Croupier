class MesasScreen extends StatefulWidget {
  final String eventoId, nombreEvento;
  const MesasScreen({super.key, required this.eventoId, required this.nombreEvento});
  @override State<MesasScreen> createState() => _MesasScreenState();
}
class _MesasScreenState extends State<MesasScreen> {

  Future<void> _sincronizar() async {
    final db   = FirebaseFirestore.instance;
    final snap = await db.collection('eventos').doc(widget.eventoId).collection('mesas').get();
    int cont = 0;
    for (final m in snap.docs) {
      final aSnap = await m.reference.collection('jugadores_activos').get();
      for (final j in aSnap.docs) {
        final jd = j.data() as Map<String, dynamic>;
        if (jd['master_id'] != null) {
          final g = await db.collection('Jugadores').doc(jd['master_id']).get();
          if (g.exists) {
            final gd = g.data() as Map<String, dynamic>;
            await j.reference.update({'nombre': gd['nombre'] ?? '', 'apodo': gd['apodo'] ?? '',
              'fichas': gd['fichas'] ?? 0, 'emoji': gd['emoji'] ?? '??',
              'ciudad': gd['ciudad'] ?? '', 'club': gd['club'] ?? ''});
            cont++;
          }
        }
      }
    }
    setState(() {});
    if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text("?? $cont jugadores sincronizados",
        style: const TextStyle(color: Colors.black, fontWeight: FontWeight.bold)),
      backgroundColor: Colors.green));
  }

  Future<void> _analizarBalanceo() async {
    final db   = FirebaseFirestore.instance;
    final snap = await db.collection('eventos').doc(widget.eventoId).collection('mesas').get();
    int vaciosTotal = 0;
    List<Map<String, dynamic>> info = [];
    for (final m in snap.docs) {
      final md = m.data(); final aforo = md['jugadores'] ?? 10;
      final aSnap = await m.reference.collection('jugadores_activos').get();
      final libres = aforo - aSnap.docs.length;
      info.add({'nombre': md['nombre'] ?? 'Mesa', 'ocupados': aSnap.docs.length, 'libres': libres});
      vaciosTotal += libres as int;
    }
    String sug = "";
    for (final m in info) {
      if (m['ocupados'] > 0) {
        final libresOtras = vaciosTotal - (m['libres'] as int);
        if (m['ocupados'] <= libresOtras)
          sug += "La ${m['nombre']} tiene ${m['ocupados']} jugadores y pueden moverse.\n\n";
      }
    }
    if (sug.isEmpty) sug = "No hay mesas para disolver sin sobrepasar aforos.";
    if (mounted) showDialog(context: context, builder: (ctx) => AlertDialog(
      backgroundColor: fondoCard,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15),
        side: const BorderSide(color: verdeNeon)),
      title: const Text("?? Balanceo", style: TextStyle(color: verdeNeon, fontWeight: FontWeight.bold)),
      content: Text(sug, style: const TextStyle(color: naranjaTema, fontSize: 14, fontWeight: FontWeight.bold)),
      actions: [TextButton(onPressed: () => Navigator.pop(ctx),
        child: const Text("ENTENDIDO", style: TextStyle(color: verdeNeon, fontWeight: FontWeight.bold)))]));
  }

  Future<void> _distribuir() async {
    if (!puedeEditar) return;
    try {
      final db   = FirebaseFirestore.instance;
      final eDoc = await db.collection('eventos').doc(widget.eventoId).get();
      final ed   = eDoc.data() as Map<String, dynamic>? ?? {};
      final List<String> rosterIds = List<String>.from(ed['jugadores_ids'] ?? []);
      if (rosterIds.isEmpty) {
        if (mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
          content: Text("No hay jugadores en el Roster.", style: TextStyle(color: Colors.white)),
          backgroundColor: Colors.red));
        return;
      }
      final mesasSnap = await db.collection('eventos')
          .doc(widget.eventoId).collection('mesas').orderBy('creado').get();
      if (mesasSnap.docs.isEmpty) return;
      List<String> yasentadosMasterIds = [];
      List<Map<String, dynamic>> sillasLibres = [];
      for (final m in mesasSnap.docs) {
        final md = m.data(); final aforo = md['jugadores'] ?? 10;
        final aSnap = await m.reference.collection('jugadores_activos').get();
        List<int> ocupados = [];
        for (final j in aSnap.docs) {
          final jd = j.data() as Map<String, dynamic>;
          final id = int.tryParse(j.id) ?? -1;
          if (id != -1) ocupados.add(id);
          if (jd['master_id'] != null) yasentadosMasterIds.add(jd['master_id']);
        }
        for (int i = 0; i < aforo; i++) {
          if (!ocupados.contains(i)) sillasLibres.add({'mesa_ref': m.reference, 'asiento': i});
        }
      }
      final jSnap = await db.collection('Jugadores').get();
      List<DocumentSnapshot> porSentar = jSnap.docs
        .where((d) => rosterIds.contains(d.id) && !yasentadosMasterIds.contains(d.id)).toList();
      if (porSentar.isEmpty) return;
      Map<String, List<DocumentSnapshot>> porClub = {};
      for (final d in porSentar) {
        String cl = ((d.data() as Map)['club']?.toString().toUpperCase().trim() ?? '').isEmpty
          ? 'SIN' : (d.data() as Map)['club'].toString().toUpperCase().trim();
        (porClub[cl] ??= []).add(d);
      }
      final claves = porClub.keys.toList()
        ..sort((a, b) => porClub[b]!.length.compareTo(porClub[a]!.length));
      List<DocumentSnapshot> ordenados = [];
      bool quedan = true;
      while (quedan) {
        quedan = false;
        for (final k in claves) {
          if (porClub[k]!.isNotEmpty) { ordenados.add(porClub[k]!.removeAt(0)); quedan = true; }
        }
      }
      Map<String, List<Map<String, dynamic>>> sillasPorMesa = {};
      for (final s in sillasLibres) {
        final id = (s['mesa_ref'] as DocumentReference).id;
        (sillasPorMesa[id] ??= []).add(s);
      }
      List<Map<String, dynamic>> orden = [];
      bool haySillas = true;
      while (haySillas) {
        haySillas = false;
        for (final ls in sillasPorMesa.values) {
          if (ls.isNotEmpty) { orden.add(ls.removeAt(0)); haySillas = true; }
        }
      }
      int cnt = 0;
      for (final pDoc in ordenados) {
        if (orden.isEmpty) break;
        final jd = pDoc.data() as Map<String, dynamic>? ?? {};
        final s  = orden.removeAt(0);
        await (s['mesa_ref'] as DocumentReference).collection('jugadores_activos')
          .doc((s['asiento'] as int).toString()).set({
            'nombre': jd['nombre']?.toString() ?? 'Jugador',
            'apodo':  jd['apodo']?.toString()  ?? 'Jugador',
            'fichas': int.tryParse(jd['fichas']?.toString() ?? '0') ?? 0,
            'emoji':  jd['emoji']?.toString()  ?? '??',
            'ciudad': jd['ciudad']?.toString() ?? '',
            'club':   jd['club']?.toString()   ?? '',
            'asiento': s['asiento'], 'master_id': pDoc.id,
          });
        cnt++;
      }
      await _registrarHistorial(widget.eventoId, "Distribución equitativa: $cnt jugadores");
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text("? $cnt jugadores distribuidos",
