  void _mostrarOverlay(BuildContext ctx, DocumentReference ref, String nombre) {
    if (_overlay != null) return;
    String _ordenVR = 'asiento'; // 'asiento', 'fichas_desc', 'fichas_asc', 'nombre'
    _overlay = OverlayEntry(builder: (_) => _VistaRapidaOverlay(
      ref: ref, nombre: nombre, onClose: _ocultarOverlay));
    Overlay.of(ctx).insert(_overlay!);
  }
  void _ocultarOverlay() { _overlay?.remove(); _overlay = null; }
  @override void dispose() { _ocultarOverlay(); super.dispose(); }

