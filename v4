// RELOJ TORNEO (FIREBASE)
// ----------------------------------------------------------------
class TorneoTimerManager {
  static final Map<String, ValueNotifier<int>>  times      = {};
  static final Map<String, ValueNotifier<bool>> runnings   = {};
  static final Map<String, ValueNotifier<bool>> enDescanso = {};
  static final Map<String, Timer?>              timers     = {};
  static final Map<String, StreamSubscription?> subs       = {};

  static void init(String id) {
    if (times.containsKey(id)) return;
    times[id]      = ValueNotifier<int>(1800);
    runnings[id]   = ValueNotifier<bool>(false);
    enDescanso[id] = ValueNotifier<bool>(false);
    subs[id] = FirebaseFirestore.instance
        .collection('eventos').doc(id).snapshots().listen((doc) {
      if (!doc.exists || doc.data() == null) return;
      final d = doc.data()!;
      final bool corriendo = d['torneo_timer_running'] ?? false;
      final bool descanso  = d['torneo_en_descanso']   ?? false;
      final int  remaining = d['torneo_remaining']      ?? 1800;
      runnings[id]!.value   = corriendo;
      enDescanso[id]!.value = descanso;
      timers[id]?.cancel();
      if (corriendo) {
        final Timestamp? ts = d['torneo_start_time'];
        final DateTime start = ts?.toDate() ?? DateTime.now();
        _correrLocal(id, start, remaining, d['torneo_duration'] ?? 1800, d['nivel'] ?? 1);
      } else {
        times[id]!.value = remaining;
      }
    });
  }

  static void _correrLocal(String id, DateTime start, int remAtStart, int dur, int nivel) {
    timers[id]?.cancel();
    timers[id] = Timer.periodic(const Duration(seconds: 1), (_) {
      final passed  = DateTime.now().difference(start).inSeconds;
      final current = remAtStart - passed;
      if (current <= 0) {
        timers[id]?.cancel();
        if (!kIsWeb) FlutterRingtonePlayer().playAlarm(looping: false, volume: 1.0);
        _avanzarNivel(id, nivel, dur);
      } else {
        times[id]!.value = current;
        if (current == 180 && !kIsWeb) FlutterRingtonePlayer().playNotification();
      }
    });
  }

  static Future<void> _avanzarNivel(String id, int nivelActual, int dur) async {
    final ref  = FirebaseFirestore.instance.collection('eventos').doc(id);
    final snap = await ref.get();
    final d    = snap.data() as Map<String, dynamic>? ?? {};
    final List niveles = d['estructura_niveles'] ?? [];
    int sigNivel = nivelActual + 1;
    int sigSB = (d['ciega_pequena'] ?? 100) * 2;
    int sigBB = (d['ciega_grande']  ?? 200) * 2;
    int sigAnte = d['ante'] ?? 0;
    if (niveles.length >= sigNivel) {
      final n = niveles[sigNivel - 1] as Map<String, dynamic>? ?? {};
      sigSB = n['sb'] ?? sigSB; sigBB = n['bb'] ?? sigBB; sigAnte = n['ante'] ?? sigAnte;
    }
    await ref.set({
      'nivel': sigNivel, 'ciega_pequena': sigSB, 'ciega_grande': sigBB, 'ante': sigAnte,
      'torneo_timer_running': true,
      'torneo_start_time': FieldValue.serverTimestamp(),
      'torneo_remaining': dur, 'torneo_duration': dur,
    }, SetOptions(merge: true));
  }

  static Future<void> toggle(String id) async {
    init(id);
    final ref  = FirebaseFirestore.instance.collection('eventos').doc(id);
    final snap = await ref.get();
    final d    = snap.data() as Map<String, dynamic>? ?? {};
    if (d['torneo_timer_running'] ?? false) {
      await ref.set({'torneo_timer_running': false,
        'torneo_remaining': times[id]!.value}, SetOptions(merge: true));
    } else {
      int rem = d['torneo_remaining'] ?? d['torneo_duration'] ?? 1800;
      if (rem <= 0) rem = d['torneo_duration'] ?? 1800;
      await ref.set({
        'torneo_timer_running': true,
        'torneo_start_time': FieldValue.serverTimestamp(),
        'torneo_remaining': rem, 'torneo_duration': d['torneo_duration'] ?? 1800,
      }, SetOptions(merge: true));
    }
  }

  static Future<void> iniciarDescanso(String id, int seg) async {
    await FirebaseFirestore.instance.collection('eventos').doc(id).set({
      'torneo_en_descanso': true, 'torneo_timer_running': true,
      'torneo_start_time': FieldValue.serverTimestamp(),
      'torneo_remaining': seg, 'torneo_duration': seg,
    }, SetOptions(merge: true));
  }

  static Future<void> cancelarDescanso(String id) async {
    final ref  = FirebaseFirestore.instance.collection('eventos').doc(id);
    final snap = await ref.get();
    final d    = snap.data() as Map<String, dynamic>? ?? {};
    await ref.set({'torneo_en_descanso': false,
      'torneo_timer_running': false,
      'torneo_remaining': d['torneo_duracion_ronda'] ?? 1800}, SetOptions(merge: true));
  }

  static Future<void> ajustar(String id, int seg) async {
    await FirebaseFirestore.instance.collection('eventos').doc(id).set({
      'torneo_timer_running': false, 'torneo_remaining': seg,
      'torneo_duration': seg, 'torneo_duracion_ronda': seg,
    }, SetOptions(merge: true));
  }
}

// ----------------------------------------------------------------
// ROTACIÓN DEALERS
// ----------------------------------------------------------------
Future<void> _proponerRelevo(String eventoId) async {
  final ctx = navigatorKey.currentContext;
  if (ctx == null) return;
  try {
    final db    = FirebaseFirestore.instance;
    final eDoc  = await db.collection('eventos').doc(eventoId).get();
    final eData = eDoc.data() as Map<String, dynamic>? ?? {};
    final String nombre = eData['nombre']?.toString() ?? 'Evento';
    final List<String> permitidos = List<String>.from(eData['dealers_ids'] ?? []);
    final dSnap = await db.collection('Dealers').get();
    final mSnap = await db.collection('eventos').doc(eventoId)
        .collection('mesas').orderBy('creado').get();

    List<Map<String, dynamic>> mesasActivas = [];
    List<String> trabajandoIds = [];
    for (final m in mSnap.docs) {
      final d = m.data();
      if (d['dealer_id'] != null) {
        mesasActivas.add({'ref': m.reference,
          'nombreMesa': d['nombre']?.toString() ?? 'Mesa',
          'dealerActualId': d['dealer_id'],
          'dealerActualApodo': d['dealer_apodo']?.toString() ?? 'Dealer',
          'historial': d['dealers_pasados'] ?? []});
        trabajandoIds.add(d['dealer_id'] as String);
      }
    }
    if (mesasActivas.isEmpty) { _mostrarAlerta(ctx, "TIEMPO CUMPLIDO", "No hay dealers activos."); return; }
    final pool = dSnap.docs.where((d) => permitidos.contains(d.id)).toList();
    if (pool.isEmpty) { _mostrarAlerta(ctx, "AVISO", "No hay dealers en el Roster."); return; }

    List<DocumentSnapshot> descansando = pool
        .where((d) => !trabajandoIds.contains(d.id)).toList()
      ..sort((a, b) {
        final ra = (a.data() as Map)['rondas_trabajadas'] ?? 0;
        final rb = (b.data() as Map)['rondas_trabajadas'] ?? 0;
        return (ra as int).compareTo(rb as int);
      });
    List<DocumentSnapshot> trabajandoDocs = [];
    for (final m in mesasActivas) {
      try { trabajandoDocs.add(pool.firstWhere((d) => d.id == m['dealerActualId'])); } catch (_) {}
    }
    List<DocumentSnapshot> circulo = [...trabajandoDocs, ...descansando];
    if (circulo.length > 1) { final u = circulo.removeLast(); circulo.insert(0, u); }

    List<Map<String, dynamic>> cambios = [];
    String log = "ROTACIÓN — $nombre:\n";
    for (int i = 0; i < mesasActivas.length && i < circulo.length; i++) {
      final mesa = mesasActivas[i]; final dealer = circulo[i];
      final nd = dealer.data() as Map<String, dynamic>;
