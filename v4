class _VistaRapidaOverlay extends StatefulWidget {
  final DocumentReference ref;
  final String nombre;
  final VoidCallback onClose;
  const _VistaRapidaOverlay({required this.ref, required this.nombre, required this.onClose});
  @override State<_VistaRapidaOverlay> createState() => _VistaRapidaOverlayState();
}
class _VistaRapidaOverlayState extends State<_VistaRapidaOverlay> {
  String _orden = 'fichas_desc';
  String _filtroClub = '';
  List<Map<String, dynamic>> _jugadores = [];
  Map<String, dynamic> _mesaData = {};
  bool _cargando = true;

  @override
  void initState() { super.initState(); _cargar(); }

  Future<void> _cargar() async {
    final ms  = await widget.ref.get();
    final js  = await widget.ref.collection('jugadores_activos').get();
    setState(() {
      _mesaData  = ms.data() as Map<String, dynamic>? ?? {};
      _jugadores = js.docs.map((d) => {
        ...d.data() as Map<String, dynamic>, '_id': d.id,
        '_num': (int.tryParse(d.id) ?? 0) + 1,
      }).toList();
      _cargando = false;
    });
  }

  List<Map<String, dynamic>> get _filtrados {
    var lista = List<Map<String, dynamic>>.from(_jugadores);
    if (_filtroClub.isNotEmpty) {
      lista = lista.where((j) =>
        (j['club']?.toString().toLowerCase() ?? '').contains(_filtroClub.toLowerCase())).toList();
    }
    switch (_orden) {
      case 'fichas_desc': lista.sort((a, b) => ((b['fichas'] ?? 0) as int).compareTo((a['fichas'] ?? 0) as int)); break;
      case 'fichas_asc':  lista.sort((a, b) => ((a['fichas'] ?? 0) as int).compareTo((b['fichas'] ?? 0) as int)); break;
      case 'nombre':      lista.sort((a, b) => (a['nombre'] ?? '').toString().compareTo((b['nombre'] ?? '').toString())); break;
      case 'ciudad':      lista.sort((a, b) => (a['ciudad'] ?? '').toString().compareTo((b['ciudad'] ?? '').toString())); break;
      case 'club':        lista.sort((a, b) => (a['club'] ?? '').toString().compareTo((b['club'] ?? '').toString())); break;
      default:            lista.sort((a, b) => (a['_num'] as int).compareTo(b['_num'] as int));
    }
    return lista;
  }

  // Clubes únicos para filtro rápido
  List<String> get _clubes {
    final Set<String> s = {};
    for (final j in _jugadores) {
      final c = j['club']?.toString().trim() ?? '';
      if (c.isNotEmpty) s.add(c);
    }
    return s.toList()..sort();
  }

  int get _totalFichas => _jugadores.fold(0, (s, j) => s + ((j['fichas'] ?? 0) as int));

  @override
  Widget build(BuildContext context) {
    final dCiudad  = _mesaData['dealer_ciudad']?.toString().trim() ?? '';
    final dApodo   = _mesaData['dealer_apodo']?.toString() ?? 'SIN DEALER';
    final dEmoji   = _mesaData['dealer_emoji']?.toString() ?? '??';
    final filtrados = _filtrados;

    return Stack(children: [
      Positioned.fill(child: GestureDetector(onTap: widget.onClose,
        child: Container(color: Colors.black87))),
      Center(child: Material(color: Colors.transparent,
        child: Container(
          width: MediaQuery.of(context).size.width * 0.88,
          constraints: BoxConstraints(maxHeight: MediaQuery.of(context).size.height * 0.82),
          decoration: BoxDecoration(color: fondoCard, borderRadius: BorderRadius.circular(15),
            border: Border.all(color: verdeNeon, width: 2)),
          child: Column(mainAxisSize: MainAxisSize.min, children: [
            // Header
            Padding(padding: const EdgeInsets.fromLTRB(16, 12, 8, 0),
              child: Row(children: [
                Expanded(child: Text("Vista Rápida: ${widget.nombre}",
                  style: const TextStyle(color: verdeNeon, fontWeight: FontWeight.w900, fontSize: 16))),
                IconButton(icon: const Icon(Icons.close, color: Colors.redAccent, size: 24),
                  onPressed: widget.onClose),
              ])),
            // Dealer
            if (!_cargando) Padding(padding: const EdgeInsets.fromLTRB(16, 4, 16, 0),
              child: Row(children: [
                Text(dEmoji, style: const TextStyle(fontSize: 20)),
                const SizedBox(width: 8),
                Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                  Row(children: [
                    const Text("Dealer: ", style: TextStyle(color: Colors.white54, fontSize: 12)),
                    Text(dApodo, style: const TextStyle(color: naranjaTema,
                      fontWeight: FontWeight.w800, fontSize: 14)),
                  ]),
                  if (dCiudad.isNotEmpty)
                    Text("?? $dCiudad", style: const TextStyle(color: turquesaTema,
                      fontSize: 11, fontWeight: FontWeight.w600)),
                ]),
              ])),
            const Divider(color: Colors.white12, height: 16),
            // Controles de filtro y orden
            if (!_cargando) Padding(padding: const EdgeInsets.symmetric(horizontal: 12),
              child: Column(children: [
                // Chips de ordenamiento
                SingleChildScrollView(scrollDirection: Axis.horizontal,
                  child: Row(children: [
                    const Text("Ordenar: ", style: TextStyle(color: Colors.white38, fontSize: 11)),
                    ...[
                      {'id': 'asiento',     'label': '# Silla'},
                      {'id': 'fichas_desc', 'label': '?? Más fichas'},
                      {'id': 'fichas_asc',  'label': '?? Menos fichas'},
                      {'id': 'nombre',      'label': 'A-Z Nombre'},
                      {'id': 'ciudad',      'label': '?? Ciudad'},
                      {'id': 'club',        'label': '??? Club'},
                    ].map((o) {
                      final sel = _orden == o['id'];
                      return Padding(padding: const EdgeInsets.only(right: 6),
                        child: GestureDetector(
                          onTap: () => setState(() => _orden = o['id']!),
                          child: Container(
                            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                            decoration: BoxDecoration(
                              color: sel ? verdeNeon.withOpacity(0.2) : Colors.black26,
                              borderRadius: BorderRadius.circular(20),
                              border: Border.all(color: sel ? verdeNeon : Colors.white12)),
                            child: Text(o['label']!, style: TextStyle(
                              color: sel ? verdeNeon : Colors.white54,
                              fontSize: 11, fontWeight: sel ? FontWeight.w800 : FontWeight.normal)))));
                    }),
                  ])),
                // Filtro por club si hay clubes
                if (_clubes.isNotEmpty) ...[
                  const SizedBox(height: 6),
                  SingleChildScrollView(scrollDirection: Axis.horizontal,
                    child: Row(children: [
                      const Text("Club: ", style: TextStyle(color: Colors.white38, fontSize: 11)),
                      GestureDetector(
                        onTap: () => setState(() => _filtroClub = ''),
                        child: Container(
                          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                          margin: const EdgeInsets.only(right: 6),
                          decoration: BoxDecoration(
                            color: _filtroClub.isEmpty ? Colors.amber.withOpacity(0.2) : Colors.black26,
                            borderRadius: BorderRadius.circular(20),
                            border: Border.all(color: _filtroClub.isEmpty ? Colors.amber : Colors.white12)),
                          child: Text("Todos", style: TextStyle(
                            color: _filtroClub.isEmpty ? Colors.amber : Colors.white54,
                            fontSize: 11, fontWeight: _filtroClub.isEmpty ? FontWeight.w800 : FontWeight.normal)))),
                      ..._clubes.map((c) {
                        final sel = _filtroClub == c;
                        return GestureDetector(
                          onTap: () => setState(() => _filtroClub = sel ? '' : c),
                          child: Container(
                            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                            margin: const EdgeInsets.only(right: 6),
                            decoration: BoxDecoration(
                              color: sel ? Colors.amber.withOpacity(0.2) : Colors.black26,
                              borderRadius: BorderRadius.circular(20),
                              border: Border.all(color: sel ? Colors.amber : Colors.white12)),
                            child: Text("??? $c", style: TextStyle(
                              color: sel ? Colors.amber : Colors.white54,
                              fontSize: 11, fontWeight: sel ? FontWeight.w800 : FontWeight.normal))));
                      }),
                    ])),
                ],
                const SizedBox(height: 6),
                // Stats rápidas
                Row(children: [
                  _statChip("Jugadores", "${filtrados.length}", verdeNeon),
                  const SizedBox(width: 8),
                  _statChip("Total Fichas", _totalFichas.toString(), Colors.amber),
                  if (filtrados.isNotEmpty) ...[
                    const SizedBox(width: 8),
                    _statChip("Líder", filtrados.first['apodo']?.toString() ?? '-', turquesaTema),
                  ],
                ]),
              ])),
            const Divider(color: Colors.white12, height: 8),
            // Lista
            if (_cargando)
              const Padding(padding: EdgeInsets.all(20),
                child: CircularProgressIndicator(color: verdeNeon))
            else if (filtrados.isEmpty)
              Padding(padding: const EdgeInsets.all(20),
                child: Text("Sin jugadores", style: TextStyle(color: naranjaTema.withOpacity(0.5))))
            else
              Flexible(child: ListView.builder(
                shrinkWrap: true,
                padding: const EdgeInsets.fromLTRB(16, 4, 16, 12),
                itemCount: filtrados.length,
                itemBuilder: (_, i) {
                  final jd     = filtrados[i];
                  final ciudad = jd['ciudad']?.toString().trim() ?? '';
                  final club   = jd['club']?.toString().trim()   ?? '';
                  final fichas = (jd['fichas'] ?? 0) as int;
                  final maxF   = _filtrados.isNotEmpty
                    ? ((_filtrados.first['fichas'] ?? 0) as int) : 1;
                  final pct    = maxF > 0 ? fichas / maxF : 0.0;
                  return Padding(padding: const EdgeInsets.symmetric(vertical: 5),
                    child: Row(children: [
                      SizedBox(width: 26, child: Text("${jd['_num']}.",
                        style: TextStyle(
                          color: i == 0 && _orden.startsWith('fichas') ? Colors.amber : naranjaTema,
                          fontWeight: FontWeight.w900, fontSize: 13))),
                      Text(jd['emoji']?.toString() ?? '??', style: const TextStyle(fontSize: 15)),
                      const SizedBox(width: 8),
                      Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                        Text("${jd['nombre'] ?? ''} \"${jd['apodo'] ?? ''}\"",
                          style: const TextStyle(color: naranjaTema, fontSize: 13, fontWeight: FontWeight.w700)),
                        Row(children: [
                          if (ciudad.isNotEmpty) Text("?? $ciudad",
                            style: const TextStyle(color: turquesaTema, fontSize: 10, fontWeight: FontWeight.w600)),
                          if (ciudad.isNotEmpty && club.isNotEmpty)
                            const Text("  ·  ", style: TextStyle(color: Colors.white24, fontSize: 10)),
                          if (club.isNotEmpty) Text("??? $club",
                            style: TextStyle(color: Colors.amber[400], fontSize: 10, fontWeight: FontWeight.w700)),
                        ]),
                        // Barra proporcional de fichas
                        const SizedBox(height: 3),
                        ClipRRect(borderRadius: BorderRadius.circular(3),
                          child: LinearProgressIndicator(
                            value: pct.clamp(0.0, 1.0),
                            minHeight: 3,
                            backgroundColor: Colors.white12,
                            valueColor: AlwaysStoppedAnimation(
                              i == 0 && _orden.startsWith('fichas') ? Colors.amber : verdeNeon))),
                      ])),
                      const SizedBox(width: 10),
                      Column(crossAxisAlignment: CrossAxisAlignment.end, children: [
                        Row(mainAxisSize: MainAxisSize.min, children: [
                          const FichaPokerIcon(color: verdeNeon, size: 12),
                          const SizedBox(width: 4),
                          Text("$fichas", style: const TextStyle(color: Colors.white,
                            fontWeight: FontWeight.w900, fontSize: 13)),
                        ]),
                        Text("${(pct * 100).toStringAsFixed(0)}%",
                          style: const TextStyle(color: Colors.white38, fontSize: 9)),
                      ]),
                    ]));
                })),
          ])))),
    ]);
  }

  Widget _statChip(String label, String val, Color color) => Container(
    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
    decoration: BoxDecoration(color: color.withOpacity(0.1),
      borderRadius: BorderRadius.circular(20), border: Border.all(color: color.withOpacity(0.3))),
    child: Row(mainAxisSize: MainAxisSize.min, children: [
      Text("$label: ", style: TextStyle(color: color.withOpacity(0.7), fontSize: 10)),
      Text(val, style: TextStyle(color: color, fontWeight: FontWeight.w900, fontSize: 11)),
    ]));
}

class JuegoMesaScreen extends StatefulWidget {
  final String eventoId, mesaId, nombreMesa;
  final int aforoMesa;
  const JuegoMesaScreen({super.key, required this.eventoId, required this.mesaId,
    required this.aforoMesa, required this.nombreMesa});
  @override State<JuegoMesaScreen> createState() => _JuegoMesaState();
}
class _JuegoMesaState extends State<JuegoMesaScreen> {
  DocumentReference get _mesaRef => FirebaseFirestore.instance
    .collection('eventos').doc(widget.eventoId)
    .collection('mesas').doc(widget.mesaId);

  Future<void> _sincronizar() async {
    final aSnap = await _mesaRef.collection('jugadores_activos').get();
    for (final j in aSnap.docs) {
