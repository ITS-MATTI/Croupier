            divisions: (10 - minC).toInt(), label: cant.toInt().toString(),
            activeColor: verdeNeon, onChanged: (v) => setM(() => cant = v)),
          Text("${cant.toInt()} jugadores máx",
            style: const TextStyle(color: verdeNeon, fontWeight: FontWeight.w900)),
          if (isEdit) Text("($sentados sentados)",
            style: TextStyle(color: naranjaTema.withOpacity(0.6), fontSize: 12)),
