class EventStatsBanner extends StatefulWidget {
  final String eventoId;
  const EventStatsBanner({super.key, required this.eventoId});
  @override State<EventStatsBanner> createState() => _ESBState();
}
class _ESBState extends State<EventStatsBanner> {
  int jS = 0, jR = 0, dA = 0, dR = 0;
  StreamSubscription? _sub;

  @override
  void initState() {
    super.initState();
    _sub = FirebaseFirestore.instance.collection('eventos')
        .doc(widget.eventoId).snapshots().listen((_) => _cargar());
    _cargar();
  }

  Future<void> _cargar() async {
    try {
      final eS = await FirebaseFirestore.instance.collection('eventos').doc(widget.eventoId).get();
      final mS = await FirebaseFirestore.instance.collection('eventos')
          .doc(widget.eventoId).collection('mesas').get();
      final d = eS.data() as Map<String, dynamic>? ?? {};
      int js = 0, da = 0;
      for (final m in mS.docs) {
        if ((m.data())['dealer_id'] != null) da++;
        final a = await m.reference.collection('jugadores_activos').get();
        js += a.docs.length;
      }
      if (mounted) setState(() {
        jS = js; dA = da;
        jR = (d['jugadores_ids'] as List?)?.length ?? 0;
        dR = (d['dealers_ids']   as List?)?.length ?? 0;
      });
    } catch (_) {}
  }

  @override void dispose() { _sub?.cancel(); super.dispose(); }

  @override
  Widget build(BuildContext context) => Container(
    width: double.infinity,
    decoration: BoxDecoration(color: fondoMid,
      border: Border(bottom: BorderSide(color: verdeNeon.withOpacity(0.3), width: 1))),
    padding: const EdgeInsets.symmetric(vertical: 10),
    child: Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, children: [
      Row(children: [
        const Icon(Icons.event_seat, color: verdeNeon, size: 20),
        const SizedBox(width: 8),
        const Text("JUGADORES: ", style: TextStyle(color: naranjaTema,
          fontWeight: FontWeight.w800, fontSize: 12, letterSpacing: 1)),
        Text("$jS / $jR", style: const TextStyle(color: verdeNeon,
          fontWeight: FontWeight.w900, fontSize: 14)),
      ]),
      Container(width: 1, height: 25, color: verdeNeon.withOpacity(0.3)),
      Row(children: [
        const Icon(Icons.badge, color: verdeNeon, size: 20),
        const SizedBox(width: 8),
        const Text("DEALERS: ", style: TextStyle(color: naranjaTema,
          fontWeight: FontWeight.w800, fontSize: 12, letterSpacing: 1)),
        Text("$dA / $dR", style: const TextStyle(color: verdeNeon,
          fontWeight: FontWeight.w900, fontSize: 14)),
      ]),
    ]));
}

