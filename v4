  Future<void> _llenarAleatorio() async {
    if (!puedeEditar) return;
    try {
      final eDoc = await FirebaseFirestore.instance.collection('eventos').doc(widget.eventoId).get();
      final ed   = eDoc.data() as Map<String, dynamic>? ?? {};
      final List<String> jugPerm  = List<String>.from(ed['jugadores_ids'] ?? []);
      final List<String> dealPerm = List<String>.from(ed['dealers_ids']   ?? []);
      if (jugPerm.isEmpty) return;
      final mesasSnap = await FirebaseFirestore.instance.collection('eventos')
          .doc(widget.eventoId).collection('mesas').get();
      final dSnap = await FirebaseFirestore.instance.collection('Dealers').get();
      final mesaActualDoc = await _mesaRef.get();
      final mesaData = mesaActualDoc.data() as Map<String, dynamic>? ?? {};
      if (mesaData['dealer_id'] == null) {
        List<String> dOcup = [];
        for (final m in mesasSnap.docs) {
          if (m.id == widget.mesaId) continue;
          final md = m.data();
          if (md['dealer_id'] != null) dOcup.add(md['dealer_id']);
        }
        final disponibles = dSnap.docs.where((d) =>
          dealPerm.contains(d.id) && !dOcup.contains(d.id)).toList()..shuffle();
        if (disponibles.isNotEmpty) {
          final dd = disponibles.first.data() as Map<String, dynamic>? ?? {};
          await _mesaRef.update({
            'dealer_id': disponibles.first.id, 'dealer_nombre': dd['nombre'] ?? 'Crupier',
            'dealer_apodo': dd['apodo'] ?? 'Dealer', 'dealer_emoji': dd['emoji'] ?? '??',
            'dealer_ciudad': dd['ciudad'] ?? '',
            'dealers_pasados': FieldValue.arrayUnion([disponibles.first.id]),
          });
        }
      }
      final jSnap = await FirebaseFirestore.instance.collection('Jugadores').get();
      List<String> nombresOcup = [];
      for (final m in mesasSnap.docs) {
        final aSnap = await m.reference.collection('jugadores_activos').get();
        for (final j in aSnap.docs) {
          final jd = j.data() as Map<String, dynamic>;
          nombresOcup.add((jd['nombre']?.toString() ?? '').toLowerCase().trim());
        }
      }
      List<DocumentSnapshot> candidatos = jSnap.docs.where((d) {
        final dd = d.data() as Map<String, dynamic>? ?? {};
        final n  = (dd['nombre']?.toString() ?? '').toLowerCase().trim();
        return jugPerm.contains(d.id) && n.isNotEmpty && !nombresOcup.contains(n);
      }).toList()..shuffle();
      final aSnap = await _mesaRef.collection('jugadores_activos').get();
      final ocupados = aSnap.docs.map((d) => int.tryParse(d.id) ?? -1).toList();
      final libres = List.generate(widget.aforoMesa, (i) => i)
        .where((i) => !ocupados.contains(i)).toList()..shuffle();
      int cnt = 0;
      for (final asiento in libres) {
        if (candidatos.isEmpty) break;
        final elegido = candidatos.removeAt(0);
        final dd = elegido.data() as Map<String, dynamic>? ?? {};
        await _mesaRef.collection('jugadores_activos').doc(asiento.toString()).set({
          'nombre':   dd['nombre']?.toString()  ?? 'Jugador',
          'apodo':    dd['apodo']?.toString()   ?? 'Jugador',
          'fichas':   int.tryParse(dd['fichas']?.toString() ?? '0') ?? 0,
          'emoji':    dd['emoji']?.toString()   ?? '??',
          'ciudad':   dd['ciudad']?.toString()  ?? '',
          'club':     dd['club']?.toString()    ?? '',
          'asiento':  asiento, 'master_id': elegido.id,
        });
        cnt++;
      }
      if (cnt > 0) await _registrarHistorial(widget.eventoId, "Llenado aleatorio ${widget.nombreMesa}");
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
        content: Text("? Mesa llenada",
          style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold)),
        backgroundColor: Colors.green));
    } catch (e) { debugPrint(e.toString()); }
  }

  Future<void> _disolverMesa() async {
    if (!puedeEditar) return;
    final db = FirebaseFirestore.instance;
    final misJug = await _mesaRef.collection('jugadores_activos').get();
    if (misJug.docs.isEmpty) return;
    final mesasSnap = await db.collection('eventos').doc(widget.eventoId).collection('mesas').get();
    List<Map<String, dynamic>> sillasLibres = [];
    for (final m in mesasSnap.docs) {
      if (m.id == widget.mesaId) continue;
      final md = m.data(); final aforo = md['jugadores'] ?? 10;
      final aSnap = await m.reference.collection('jugadores_activos').get();
      final ocupados = aSnap.docs.map((d) => int.parse(d.id)).toList();
      for (int i = 0; i < aforo; i++) {
        if (!ocupados.contains(i)) sillasLibres.add(
          {'mesa_id': m.id, 'mesa_nombre': md['nombre'] ?? 'Mesa', 'asiento': i});
      }
    }
    if (misJug.docs.length > sillasLibres.length) {
      if (mounted) _mostrarAlerta(context, "Error de balanceo",
        "No hay suficientes sillas libres (${misJug.docs.length} jugadores, ${sillasLibres.length} espacios).");
      return;
    }
    sillasLibres.shuffle();
    String reporte = "";
    final batch = db.batch();
    for (final jugDoc in misJug.docs) {
      final jd   = jugDoc.data() as Map<String, dynamic>;
      final dest = sillasLibres.removeLast();
      final nuevaRef = db.collection('eventos').doc(widget.eventoId)
        .collection('mesas').doc(dest['mesa_id'])
        .collection('jugadores_activos').doc((dest['asiento'] as int).toString());
      batch.set(nuevaRef, {...jd, 'asiento': dest['asiento']});
      batch.delete(jugDoc.reference);
      reporte += "?? ${jd['apodo']} ? ${dest['mesa_nombre']} (Silla ${(dest['asiento'] as int) + 1})\n";
    }
    batch.update(_mesaRef, {
      'dealer_id': FieldValue.delete(), 'dealer_nombre': FieldValue.delete(),
      'dealer_apodo': FieldValue.delete(), 'dealer_emoji': FieldValue.delete(),
      'dealer_ciudad': FieldValue.delete(),
    });
    await batch.commit();
    await _registrarHistorial(widget.eventoId, "Mesa disuelta: ${widget.nombreMesa}\n$reporte");
    if (mounted) showDialog(context: context, barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: fondoCard,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15),
          side: const BorderSide(color: verdeNeon)),
        title: const Text("? Mesa Disuelta",
          style: TextStyle(color: verdeNeon, fontWeight: FontWeight.bold)),
        content: SingleChildScrollView(child: Column(mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text("Reporte:", style: TextStyle(color: naranjaTema, fontWeight: FontWeight.bold)),
            const SizedBox(height: 10),
            Text(reporte, style: const TextStyle(color: naranjaTema, fontSize: 13, fontWeight: FontWeight.bold)),
            const SizedBox(height: 15),
            const Text("¿Qué hacemos con la mesa vacía?",
              style: TextStyle(color: verdeNeon, fontWeight: FontWeight.bold)),
          ])),
        actionsAlignment: MainAxisAlignment.spaceEvenly,
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx),
            child: const Text("MANTENERLA", style: TextStyle(color: Colors.grey, fontWeight: FontWeight.bold))),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.redAccent),
            onPressed: () async {
              await _mesaRef.delete();
              if (ctx.mounted) Navigator.pop(ctx);
              if (mounted) Navigator.pop(context);
            },
            child: const Text("ELIMINARLA",
              style: TextStyle(color: Colors.white, fontWeight: FontWeight.w900))),
        ]));
  }

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(
      title: Text(widget.nombreMesa,
        style: const TextStyle(color: verdeNeon, fontSize: 18,
          fontWeight: FontWeight.w900, letterSpacing: 1.5)),
      backgroundColor: Colors.transparent, elevation: 0,
      actions: [
        StreamBuilder<DocumentSnapshot>(
          stream: _mesaRef.snapshots(),
          builder: (_, snap) {
            final d = snap.data?.data() as Map?;
            if (d?['is_mesa_final'] == true) {
              return IconButton(icon: const Icon(Icons.emoji_events, color: Colors.amber, size: 28),
                onPressed: _mostrarPodio);
            }
            return const SizedBox.shrink();
          }),
        IconButton(icon: const Icon(Icons.refresh, color: turquesaTema),
          onPressed: () { _sincronizar(); setState(() {}); }),
      ]),
    body: Stack(children: [
      Column(children: [
        DealerTimerBanner(eventoId: widget.eventoId),
        Expanded(child: StreamBuilder<DocumentSnapshot>(
          stream: _mesaRef.snapshots(),
          builder: (_, mesaSnap) {
            if (!mesaSnap.hasData) return const Center(child: CircularProgressIndicator(color: verdeNeon));
            final md = mesaSnap.data!.data() as Map<String, dynamic>? ?? {};
            return StreamBuilder<QuerySnapshot>(
              stream: _mesaRef.collection('jugadores_activos').snapshots(),
              builder: (_, actSnap) {
                Map<int, Map<String, dynamic>> ocupados = {};
                if (actSnap.hasData) {
                  for (final d in actSnap.data!.docs) {
                    final id = int.tryParse(d.id);
                    if (id != null) ocupados[id] = {
                      ...d.data() as Map<String, dynamic>, 'doc_id': d.id};
                  }
                }
                return SingleChildScrollView(
                  physics: const BouncingScrollPhysics(),
                  child: Column(children: [
                    // Dealer
                    Padding(padding: const EdgeInsets.symmetric(vertical: 10),
                      child: Column(children: [
                        GestureDetector(onTap: _seleccionarDealer,
                          child: CircleAvatar(radius: 40,
                            backgroundColor: naranjaTema.withOpacity(0.1),
                            child: Text(md['dealer_emoji']?.toString() ?? '??',
                              style: const TextStyle(fontSize: 40)))),
                        const SizedBox(height: 8),
                        Container(
                          padding: const EdgeInsets.symmetric(horizontal: 15, vertical: 4),
                          decoration: BoxDecoration(color: Colors.black,
                            borderRadius: BorderRadius.circular(15),
                            border: Border.all(color: verdeNeon.withOpacity(0.5))),
                          child: Text(
                            (md['dealer_apodo']?.toString() ?? 'SIN DEALER').toUpperCase(),
                            style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w900,
                              color: verdeNeon, letterSpacing: 1))),
                        if ((md['dealer_ciudad']?.toString().trim() ?? '').isNotEmpty)
                          Padding(padding: const EdgeInsets.only(top: 4),
                            child: Text("?? ${md['dealer_ciudad']}",
                              style: TextStyle(color: turquesaTema.withOpacity(0.8),
                                fontSize: 11, fontWeight: FontWeight.bold))),
                      ])),

                    // -- Mesa oval — layout fijo, sillas siempre visibles --
                    Builder(builder: (_) {
                      // Dimensiones fijas del área total (tapete + sillas)
                      const totalW = 780.0;
                      const totalH = 500.0;
                      const cx = totalW / 2;
                      const cy = totalH / 2;
                      // Tapete
                      const tw = 460.0;
                      const th = 220.0;
                      // Radio orbital (centro tapete ? centro silla)
                      const orx = 330.0;
                      const ory = 210.0;
                      // Tarjetas
                      const sw  = 118.0;
                      const sh  = 86.0;
                      const shL = 52.0;
                      return SizedBox(
                        width: totalW, height: totalH,
                        child: Stack(
                          clipBehavior: Clip.none,
                          children: [
                            // Tapete centrado
                            Positioned(
                              left: cx - tw / 2, top: cy - th / 2,
                              child: Container(
                                width: tw, height: th,
                                decoration: BoxDecoration(
                                  color: const Color(0xFF072B14),
                                  borderRadius: BorderRadius.all(Radius.elliptical(tw, th)),
                                  border: Border.all(color: turquesaTema, width: 4),
                                  boxShadow: const [BoxShadow(color: Colors.black54, blurRadius: 30)]),
                                child: Center(child: _TextoMesa(eventoId: widget.eventoId)))),
                            // Sillas
                            ...List.generate(widget.aforoMesa, (i) {
                              final a  = (2 * math.pi / widget.aforoMesa) * i - (math.pi / 2);
                              final isOc = ocupados.containsKey(i);
                              final sH = isOc ? sh : shL;
                              final l  = cx + orx * math.cos(a) - sw / 2;
                              final t  = cy + ory * math.sin(a) - sH / 2;
                              return Positioned(left: l, top: t,
                                child: _buildSeat(i, ocupados[i]));
                            }),
                          ]));
                    }),

                    // Botones
                    if (puedeEditar)
                      Padding(padding: const EdgeInsets.only(bottom: 40, top: 10),
                        child: Row(mainAxisAlignment: MainAxisAlignment.center, children: [
                          ElevatedButton.icon(
                            onPressed: _llenarAleatorio,
                            icon: const Icon(Icons.shuffle, color: Colors.black),
                            label: const Text("LLENAR",
                              style: TextStyle(color: Colors.black, fontWeight: FontWeight.w900)),
                            style: ElevatedButton.styleFrom(backgroundColor: verdeNeon,
                              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 15))),
                          const SizedBox(width: 10),
                          ElevatedButton.icon(
                            onPressed: _disolverMesa,
                            icon: const Icon(Icons.delete_sweep, color: naranjaTema),
                            label: const Text("DISOLVER",
                              style: TextStyle(color: naranjaTema, fontWeight: FontWeight.w900)),
                            style: ElevatedButton.styleFrom(backgroundColor: Colors.redAccent,
                              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 15))),
                        ])),
                  ]));
              });
          })),
      ]),
      const FloatingLogo(),
    ]));

  Widget _buildSeat(int i, Map<String, dynamic>? data) {
    if (data == null) {
      return GestureDetector(
        onTap: puedeEditar ? () => _sentarManual(i) : null,
        child: Container(
          width: 120, height: 56,
          decoration: BoxDecoration(
            color: fondoMid.withOpacity(0.92),
            borderRadius: BorderRadius.circular(8),
            border: Border.all(color: naranjaTema.withOpacity(0.4), width: 1.2)),
          child: Stack(children: [
            Positioned(top: 3, right: 3, child: CircleAvatar(radius: 9,
              backgroundColor: naranjaTema,
              child: Text("${i+1}", style: const TextStyle(fontSize: 10,
                fontWeight: FontWeight.w900, color: Colors.black)))),
            const Center(child: Text("LIBRE", style: TextStyle(fontSize: 11,
              fontWeight: FontWeight.w900, color: naranjaTema, letterSpacing: 2))),
          ])));
    }
    final club   = data['club']?.toString().trim()   ?? '';
    final ciudad = data['ciudad']?.toString().trim() ?? '';
    return GestureDetector(
      onTap: puedeEditar ? () => _opcionesJugador(i, data) : null,
      child: Container(
        width: 120, height: 88,
        decoration: BoxDecoration(
          color: fondoMid.withOpacity(0.95),
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: turquesaTema, width: 1.2)),
        child: Stack(children: [
          Positioned(top: 3, right: 3, child: CircleAvatar(radius: 9,
            backgroundColor: verdeNeon,
            child: Text("${i+1}", style: const TextStyle(fontSize: 10,
              fontWeight: FontWeight.w900, color: Colors.black)))),
          Padding(padding: const EdgeInsets.fromLTRB(5, 4, 14, 4),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Row(children: [
                Text(data['emoji']?.toString() ?? '??',
                  style: const TextStyle(fontSize: 11)),
                const SizedBox(width: 3),
                Expanded(child: Text(data['nombre']?.toString() ?? '',
                  style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w800,
                    color: naranjaTema),
                  maxLines: 1, overflow: TextOverflow.ellipsis)),
              ]),
              Text('"${data['apodo'] ?? ''}"',
                style: const TextStyle(fontSize: 9, fontWeight: FontWeight.w600,
                  color: turquesaTema, fontStyle: FontStyle.italic),
                maxLines: 1, overflow: TextOverflow.ellipsis),
              if (club.isNotEmpty) Text("??? $club",
                style: TextStyle(fontSize: 8, fontWeight: FontWeight.w900,
                  color: Colors.amber[400]),
                maxLines: 1, overflow: TextOverflow.ellipsis),
              if (ciudad.isNotEmpty) Text("?? $ciudad",
                style: TextStyle(fontSize: 8, color: Colors.grey[400]),
                maxLines: 1, overflow: TextOverflow.ellipsis),
              const Spacer(),
              Row(mainAxisSize: MainAxisSize.min, children: [
                const FichaPokerIcon(color: verdeNeon, size: 11),
                const SizedBox(width: 3),
                Text("${data['fichas'] ?? 0}", style: const TextStyle(fontSize: 11,
                  fontWeight: FontWeight.w900, color: Colors.white)),
              ]),
            ])),
        ])));
  }
}

