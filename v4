// RELOJ DEALER (FIREBASE — online, persiste aunque se apague)
// Guarda en: eventos/{id}/config/dealer_timer
// ----------------------------------------------------------------
class DealerTimerManager {
  static final Map<String, ValueNotifier<int>>  times     = {};
  static final Map<String, ValueNotifier<bool>> runnings  = {};
  static final Map<String, Timer?>              timers    = {};
  static final Map<String, StreamSubscription?> subs      = {};
  static final Map<String, int>                 durations = {};

  static DocumentReference _ref(String id) => FirebaseFirestore.instance
      .collection('eventos').doc(id).collection('config').doc('dealer_timer');

  static void init(String id, {int def = 1800}) {
    if (times.containsKey(id)) return;
    times[id]    = ValueNotifier<int>(def);
    runnings[id] = ValueNotifier<bool>(false);
    durations[id] = def;
    // Escuchar Firebase
    subs[id] = _ref(id).snapshots().listen((snap) {
      if (!snap.exists) return;
      final d = snap.data() as Map<String, dynamic>;
      final bool corriendo = d['running']   ?? false;
      final int  remaining = d['remaining'] ?? def;
      final int  duration  = d['duration']  ?? def;
      durations[id] = duration;
      runnings[id]!.value = corriendo;
      timers[id]?.cancel();
      if (corriendo) {
        final Timestamp? ts = d['start_time'];
        final DateTime start = ts?.toDate() ?? DateTime.now();
        _correrLocal(id, start, remaining, duration);
      } else {
        times[id]!.value = remaining;
      }
    });
  }

  static void _correrLocal(String id, DateTime start, int remAtStart, int dur) {
    timers[id]?.cancel();
    timers[id] = Timer.periodic(const Duration(seconds: 1), (_) {
      final passed  = DateTime.now().difference(start).inSeconds;
      final current = remAtStart - passed;
      if (current <= 0) {
        timers[id]?.cancel();
        times[id]!.value = 0;
        // Sonar alarma en loop — sigue hasta que el usuario pause
        if (!kIsWeb) FlutterRingtonePlayer().playAlarm(looping: true, volume: 1.0);
        // Mostrar diálogo de rotación (no bloquea el reloj)
        _proponerRelevo(id);
        // Reiniciar automáticamente en Firebase y seguir corriendo
        _ref(id).set({
          'running':    true,
          'start_time': Timestamp.now(),
          'remaining':  dur,
          'duration':   dur,
        }, SetOptions(merge: true));
      } else {
        times[id]!.value = current;
        if (current == 180 && !kIsWeb) FlutterRingtonePlayer().playNotification();
      }
    });
  }

  static Future<void> toggle(String id) async {
    init(id);
    final snap = await _ref(id).get();
    final d    = snap.exists ? snap.data() as Map<String, dynamic> : {};
    final bool corriendo = d['running'] ?? false;
    final int  dur       = d['duration'] ?? durations[id] ?? 1800;
    if (corriendo) {
      // Pausar — detener alarma también
      timers[id]?.cancel();
      if (!kIsWeb) FlutterRingtonePlayer().stop();
      await _ref(id).set({
        'running':   false,
        'remaining': times[id]!.value > 0 ? times[id]!.value : dur,
        'duration':  dur,
      }, SetOptions(merge: true));
    } else {
      // Iniciar
      int rem = d['remaining'] ?? dur;
      if (rem <= 0) rem = dur;
      await _ref(id).set({
        'running':    true,
        'start_time': FieldValue.serverTimestamp(),
        'remaining':  rem,
        'duration':   dur,
      }, SetOptions(merge: true));
    }
  }

  static Future<void> setDuration(String id, int seg) async {
    init(id);
    timers[id]?.cancel();
    if (!kIsWeb) FlutterRingtonePlayer().stop();
    await _ref(id).set({
      'running':   false,
      'remaining': seg,
      'duration':  seg,
    }, SetOptions(merge: true));
  }

  static Future<void> reset(String id) async {
    init(id);
    timers[id]?.cancel();
    if (!kIsWeb) FlutterRingtonePlayer().stop();
    final dur = durations[id] ?? 1800;
    await _ref(id).set({
      'running':   false,
      'remaining': dur,
      'duration':  dur,
    }, SetOptions(merge: true));
  }
}

