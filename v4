Future<void> cargarTema(String eventoId) async {
  try {
    final doc = await FirebaseFirestore.instance
        .collection('config').doc('tema_$eventoId').get();
    if (!doc.exists) return;
    final data = doc.data() as Map<String, dynamic>;
    final ac = coloresNeon.firstWhere(
      (c) => c['id'] == (data['acento_id'] ?? 'verde'), orElse: () => coloresNeon.first);
    final fc = fondosDisponibles.firstWhere(
      (c) => c['id'] == (data['fondo_id'] ?? 'negro'), orElse: () => fondosDisponibles.first);
    _acentoActivo = ac['color'] as Color;
    _fondoActivo  = fc['color'] as Color;
    _modoClaro    = data['modo_claro'] ?? false;
  } catch (_) {}
}

