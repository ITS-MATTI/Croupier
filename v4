  Widget build(BuildContext context) => IconButton(
    icon: Icon(isOfflineGlobal ? Icons.wifi_off : Icons.wifi,
      color: isOfflineGlobal ? Colors.redAccent : verdeNeon),
    onPressed: () async {
      if (isOfflineGlobal) {
