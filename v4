// TEXTO MESA — editable, tipografía elegible por master
// ----------------------------------------------------------------
class _TextoMesa extends StatefulWidget {
  final String eventoId;
  const _TextoMesa({required this.eventoId});
  @override State<_TextoMesa> createState() => _TextoMesaState();
}
class _TextoMesaState extends State<_TextoMesa> {
  String _linea1  = 'The';
  String _linea2  = 'Croupier';
  String _fuente  = 'dancingScript';
  bool   _loading = true;

  static const List<Map<String, String>> _fuentes = [
    {'id': 'dancingScript', 'nombre': 'Dancing Script'},
    {'id': 'pacifico',      'nombre': 'Pacifico'},
    {'id': 'lobster',       'nombre': 'Lobster'},
    {'id': 'rajdhani',      'nombre': 'Rajdhani'},
    {'id': 'orbitron',      'nombre': 'Orbitron'},
  ];

  @override
  void initState() { super.initState(); _cargar(); }

  Future<void> _cargar() async {
    try {
      final doc = await FirebaseFirestore.instance
          .collection('config').doc('mesa_texto_${widget.eventoId}').get();
      if (doc.exists) {
        final d = doc.data() as Map<String, dynamic>;
        setState(() {
          _linea1 = d['linea1']?.toString() ?? 'The';
          _linea2 = d['linea2']?.toString() ?? 'Croupier';
          _fuente = d['fuente']?.toString() ?? 'dancingScript';
        });
      }
    } catch (_) {}
    setState(() => _loading = false);
  }

  TextStyle _estilo(double size) {
    switch (_fuente) {
      case 'pacifico':      return GoogleFonts.pacifico(fontSize: size, color: naranjaTema, height: 0.9);
      case 'lobster':       return GoogleFonts.lobster(fontSize: size, color: naranjaTema, height: 0.9);
      case 'rajdhani':      return GoogleFonts.rajdhani(fontSize: size, fontWeight: FontWeight.w900, color: naranjaTema, height: 0.9);
      case 'orbitron':      return GoogleFonts.orbitron(fontSize: size, fontWeight: FontWeight.w700, color: naranjaTema, height: 0.9);
      default:              return GoogleFonts.dancingScript(fontSize: size, fontWeight: FontWeight.bold, color: naranjaTema, height: 0.9);
    }
  }

  void _editar() {
    if (!sesionActual.esMaster) return;
    final l1C = TextEditingController(text: _linea1);
    final l2C = TextEditingController(text: _linea2);
    String fSel = _fuente;
    showDialog(context: context, builder: (ctx) =>
      StatefulBuilder(builder: (ctx, setM) => AlertDialog(
        backgroundColor: fondoCard,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15),
          side: const BorderSide(color: verdeNeon, width: 2)),
        title: const Text("?? Texto de la Mesa",
          style: TextStyle(color: verdeNeon, fontWeight: FontWeight.w900)),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          TextField(controller: l1C,
            style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold),
            decoration: const InputDecoration(labelText: "Línea 1",
              labelStyle: TextStyle(color: turquesaTema))),
          const SizedBox(height: 8),
          TextField(controller: l2C,
            style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold),
            decoration: const InputDecoration(labelText: "Línea 2",
              labelStyle: TextStyle(color: turquesaTema))),
          const SizedBox(height: 16),
          const Text("TIPOGRAFÍA", style: TextStyle(color: turquesaTema,
            fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1)),
          const SizedBox(height: 8),
          ..._fuentes.map((f) => RadioListTile<String>(
            dense: true,
            title: Text(f['nombre']!,
              style: TextStyle(color: fSel == f['id'] ? verdeNeon : naranjaTema,
                fontWeight: FontWeight.w700)),
            value: f['id']!, groupValue: fSel,
            activeColor: verdeNeon,
            onChanged: (v) => setM(() => fSel = v!))),
        ]),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx),
            child: const Text("CANCELAR", style: TextStyle(color: Colors.grey))),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: verdeNeon),
            onPressed: () async {
              await FirebaseFirestore.instance
                  .collection('config')
                  .doc('mesa_texto_${widget.eventoId}')
                  .set({'linea1': l1C.text.trim().isEmpty ? 'The' : l1C.text.trim(),
                    'linea2': l2C.text.trim().isEmpty ? 'Croupier' : l2C.text.trim(),
                    'fuente': fSel}, SetOptions(merge: true));
              setState(() {
                _linea1 = l1C.text.trim().isEmpty ? 'The' : l1C.text.trim();
                _linea2 = l2C.text.trim().isEmpty ? 'Croupier' : l2C.text.trim();
                _fuente = fSel;
              });
              if (ctx.mounted) Navigator.pop(ctx);
            },
            child: const Text("GUARDAR",
              style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
        ])));
  }

  @override
  Widget build(BuildContext context) {
    if (_loading) return const SizedBox.shrink();
    return GestureDetector(
      onLongPress: sesionActual.esMaster ? _editar : null,
      child: Column(mainAxisSize: MainAxisSize.min, children: [
        Text(_linea1, style: _estilo(20)),
        Text(_linea2, style: _estilo(34)),
        if (sesionActual.esMaster)
          const Padding(padding: EdgeInsets.only(top: 4),
            child: Icon(Icons.edit, color: Colors.white12, size: 12)),
      ]));
  }
}
