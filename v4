class _PanelTopFichas extends StatelessWidget {
  final String eventoId; final Color acento;
  const _PanelTopFichas({required this.eventoId, required this.acento});
  Stream<List<Map<String, dynamic>>> _stream() async* {
    yield* FirebaseFirestore.instance.collection('eventos')
        .doc(eventoId).collection('mesas').snapshots().asyncMap((snap) async {
      List<Map<String, dynamic>> todos = [];
      for (final m in snap.docs) {
        final a = await m.reference.collection('jugadores_activos').get();
        for (final j in a.docs) {
          final d = j.data() as Map<String, dynamic>;
          todos.add({'apodo': d['apodo'] ?? 'Jugador',
            'fichas': (d['fichas'] ?? 0) as int,
            'ciudad': d['ciudad']?.toString().trim() ?? '',
            'emoji':  d['emoji']?.toString() ?? '??'});
        }
      }
      todos.sort((a, b) => (b['fichas'] as int).compareTo(a['fichas'] as int));
      return todos.take(20).toList();
    });
  }
  @override
  Widget build(BuildContext context) => Container(color: Colors.black87,
    child: Column(children: [
      Container(width: double.infinity, padding: const EdgeInsets.symmetric(vertical: 10),
        decoration: BoxDecoration(color: Colors.black54,
          border: Border(bottom: BorderSide(color: acento.withOpacity(0.3)))),
        child: Text("?? TOP FICHAS", textAlign: TextAlign.center,
          style: TextStyle(color: acento, fontSize: 14, fontWeight: FontWeight.w900, letterSpacing: 2))),
      Expanded(child: StreamBuilder<List<Map<String, dynamic>>>(
        stream: _stream(),
        builder: (_, snap) {
          final lista = snap.data ?? [];
          return ListView.builder(itemCount: lista.length,
            itemBuilder: (_, i) {
              final j = lista[i];
              return Container(
                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                decoration: BoxDecoration(
                  border: Border(bottom: BorderSide(color: Colors.white12)),
                  color: i == 0 ? Colors.amber.withOpacity(0.08) : Colors.transparent),
                child: Row(children: [
                  Text("${i+1}. ", style: TextStyle(
                    color: i == 0 ? Colors.amber : i == 1 ? const Color(0xFFC0C0C0)
                      : i == 2 ? const Color(0xFFCD7F32) : Colors.white54,
                    fontWeight: FontWeight.w900, fontSize: 12)),
                  Text(j['emoji']?.toString() ?? '??'),
                  const SizedBox(width: 6),
                  Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                    Text(j['apodo']?.toString() ?? '', style: const TextStyle(color: Colors.white,
                      fontSize: 12, fontWeight: FontWeight.w700), overflow: TextOverflow.ellipsis),
                    if ((j['ciudad']?.toString() ?? '').isNotEmpty)
                      Text("?? ${j['ciudad']}",
                        style: const TextStyle(color: Colors.white38, fontSize: 9)),
