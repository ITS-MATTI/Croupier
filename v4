class DealerTimerBanner extends StatefulWidget {
  final String eventoId;
  const DealerTimerBanner({super.key, required this.eventoId});
  @override State<DealerTimerBanner> createState() => _DealerTimerBannerState();
}
class _DealerTimerBannerState extends State<DealerTimerBanner>
    with WidgetsBindingObserver {

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    DealerTimerManager.init(widget.eventoId);
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) _reconectar();
  }

  Future<void> _reconectar() async {
    final id   = widget.eventoId;
    final snap = await DealerTimerManager._ref(id).get();
    if (!snap.exists) return;
    final d        = snap.data() as Map<String, dynamic>;
    final corriendo = d['running']   ?? false;
    final remaining = d['remaining'] ?? 1800;
    final duration  = d['duration']  ?? 1800;
    DealerTimerManager.durations[id] = duration as int;
    DealerTimerManager.timers[id]?.cancel();
    if (corriendo) {
      final Timestamp? ts = d['start_time'];
      final start = ts?.toDate() ?? DateTime.now();
      DealerTimerManager._correrLocal(id, start, remaining as int, duration as int);
    } else {
      DealerTimerManager.times[id]?.value = remaining as int;
    }
  }

  void _ajustar(BuildContext context) {
    if (!sesionActual.puedeEditarRelojDealer) return;
    DealerTimerManager.init(widget.eventoId);
    final t    = DealerTimerManager.times[widget.eventoId]!.value;
    final minC = TextEditingController(text: (t ~/ 60).toString());
    final secC = TextEditingController(text: (t % 60).toString());
    showDialog(context: context, builder: (ctx) => AlertDialog(
      backgroundColor: fondoCard,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20),
        side: const BorderSide(color: verdeNeon, width: 2)),
      title: const Text("?? Reloj Cambio de Dealer",
        style: TextStyle(color: verdeNeon, fontWeight: FontWeight.w800), textAlign: TextAlign.center),
      content: Row(mainAxisAlignment: MainAxisAlignment.center, children: [
        SizedBox(width: 70, child: TextField(controller: minC, keyboardType: TextInputType.number,
          style: const TextStyle(fontSize: 30, color: naranjaTema, fontWeight: FontWeight.bold),
          textAlign: TextAlign.center,
          decoration: InputDecoration(labelText: "Min",
            labelStyle: TextStyle(color: naranjaTema.withOpacity(0.6))))),
        const Padding(padding: EdgeInsets.symmetric(horizontal: 10),
          child: Text(":", style: TextStyle(fontSize: 40, fontWeight: FontWeight.w900, color: naranjaTema))),
        SizedBox(width: 70, child: TextField(controller: secC, keyboardType: TextInputType.number,
          style: const TextStyle(fontSize: 30, color: naranjaTema, fontWeight: FontWeight.bold),
          textAlign: TextAlign.center,
          decoration: InputDecoration(labelText: "Seg",
            labelStyle: TextStyle(color: naranjaTema.withOpacity(0.6))))),
      ]),
      actionsAlignment: MainAxisAlignment.spaceEvenly,
      actions: [
        TextButton(onPressed: () => Navigator.pop(ctx),
          child: const Text("CANCELAR",
            style: TextStyle(color: Colors.grey, fontWeight: FontWeight.bold))),
        ElevatedButton(
          style: ElevatedButton.styleFrom(backgroundColor: verdeNeon),
          onPressed: () async {
            final m = int.tryParse(minC.text) ?? 0;
            final s = int.tryParse(secC.text) ?? 0;
            await DealerTimerManager.setDuration(widget.eventoId, m * 60 + s);
            Navigator.pop(ctx);
          },
          child: const Text("APLICAR",
            style: TextStyle(color: Colors.black, fontWeight: FontWeight.w900))),
      ]));
  }

  @override
  Widget build(BuildContext context) {
    if (isGuestMode) return const SizedBox.shrink();
    if (!sesionActual.puedeEditarRelojDealer) return const SizedBox.shrink();
    return ValueListenableBuilder<bool>(
      valueListenable: DealerTimerManager.runnings[widget.eventoId]!,
      builder: (_, running, __) => Container(
        width: double.infinity, padding: const EdgeInsets.symmetric(vertical: 8),
        decoration: BoxDecoration(
          color: running ? const Color(0xFF0E4D21) : Colors.black,
          border: const Border(top: BorderSide(color: verdeNeon, width: 2))),
        child: Row(mainAxisAlignment: MainAxisAlignment.center, children: [
          IconButton(
            icon: Icon(running ? Icons.pause_circle_filled : Icons.play_circle_fill,
              color: verdeNeon, size: 35),
            onPressed: () async => await DealerTimerManager.toggle(widget.eventoId)),
          const SizedBox(width: 15),
          GestureDetector(onTap: () => _ajustar(context),
            child: ValueListenableBuilder<int>(
              valueListenable: DealerTimerManager.times[widget.eventoId]!,
              builder: (_, time, __) {
                final m = (time ~/ 60).toString().padLeft(2, '0');
                final s = (time % 60).toString().padLeft(2, '0');
                final c = time <= 180 && time > 0 ? Colors.redAccent : naranjaTema;
                return Text("$m:$s", style: TextStyle(fontSize: 40,
                  fontWeight: FontWeight.w900, color: c, fontFamily: 'monospace', letterSpacing: 4));
              })),
          const SizedBox(width: 15),
          IconButton(icon: const Icon(Icons.refresh, color: Colors.grey),
            tooltip: "Reiniciar", onPressed: () async => await DealerTimerManager.reset(widget.eventoId)),
        ])));
  }
}

