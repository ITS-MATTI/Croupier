// -- Ticker premios ------------------------------------------
class _TickerPremios extends StatelessWidget {
  final String eventoId; final Color acento;
  const _TickerPremios({required this.eventoId, required this.acento});
  @override
  Widget build(BuildContext context) => StreamBuilder<QuerySnapshot>(
    stream: FirebaseFirestore.instance.collection('eventos')
        .doc(eventoId).collection('mesas')
        .where('is_mesa_final', isEqualTo: true).snapshots(),
    builder: (_, snap) {
      final premios = <String>[];
      if (snap.hasData) {
        for (final m in snap.data!.docs) {
          final d = m.data() as Map<String, dynamic>;
          final Map p = d['premios'] ?? {};
          p.forEach((k, v) {
            if (v.toString().isNotEmpty) {
              final num = int.tryParse(k.toString()) ?? 0;
              final ord = num == 1 ? "1er" : num == 2 ? "2do" : num == 3 ? "3er" : "${num}to";
              premios.add("?? $ord lugar: \$$v");
            }
          });
        }
      }
      premios.sort();
      if (premios.isEmpty) return const SizedBox(height: 32,
        child: Center(child: Text("Sin premios configurados",
          style: TextStyle(color: Colors.white24, fontSize: 11))));
      return Container(height: 36,
        decoration: BoxDecoration(color: Colors.black87,
          border: Border(top: BorderSide(color: acento.withOpacity(0.3)))),
        child: SingleChildScrollView(scrollDirection: Axis.horizontal,
          child: Row(children: premios.map((p) => Padding(
            padding: const EdgeInsets.symmetric(horizontal: 20),
            child: Text(p, style: TextStyle(color: acento,
              fontSize: 13, fontWeight: FontWeight.bold)))).toList())));
    });
}

// -- Overlay Descanso ----------------------------------------
class _DescansoOverlay extends StatelessWidget {
  final String eventoId; final Color acento;
  const _DescansoOverlay({required this.eventoId, required this.acento});

  Future<void> _ajustarTiempo(int deltaSegundos) async {
    final t = TorneoTimerManager.times[eventoId]!.value;
    final nuevo = (t + deltaSegundos).clamp(0, 7200);
    final ref = FirebaseFirestore.instance.collection('eventos').doc(eventoId);
    await ref.set({
      'torneo_remaining': nuevo,
      'torneo_start_time': FieldValue.serverTimestamp(),
    }, SetOptions(merge: true));
  }

  @override
  Widget build(BuildContext context) {
    TorneoTimerManager.init(eventoId);
    return Container(color: Colors.black.withOpacity(0.88),
      child: Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
        const Text("? DESCANSO", style: TextStyle(color: Colors.amber,
          fontSize: 56, fontWeight: FontWeight.w900, letterSpacing: 6)),
        const SizedBox(height: 16),
        ValueListenableBuilder<int>(
          valueListenable: TorneoTimerManager.times[eventoId]!,
          builder: (_, t, __) {
            final m = (t ~/ 60).toString().padLeft(2, '0');
            final s = (t % 60).toString().padLeft(2, '0');
            final c = t <= 60 && t > 0 ? Colors.redAccent : Colors.white;
            return Text("$m:$s", style: TextStyle(color: c,
              fontSize: 80, fontWeight: FontWeight.w900, fontFamily: 'monospace'));
          }),
        const SizedBox(height: 8),
        const Text("¡Regresa a tiempo!", style: TextStyle(color: Colors.white54,
          fontSize: 18, letterSpacing: 2)),
        const SizedBox(height: 24),
        // Controles — solo para admins
        if (sesionActual.puedeEditarAlgo)
          Row(mainAxisAlignment: MainAxisAlignment.center, children: [
            // -5 min
            _btnControl("-5m", Colors.redAccent, () => _ajustarTiempo(-300)),
            const SizedBox(width: 10),
            // -1 min
            _btnControl("-1m", Colors.orange, () => _ajustarTiempo(-60)),
            const SizedBox(width: 16),
            // Pause/Play
            ValueListenableBuilder<bool>(
              valueListenable: TorneoTimerManager.runnings[eventoId] ?? ValueNotifier(false),
              builder: (_, running, __) => GestureDetector(
                onTap: () => TorneoTimerManager.toggle(eventoId),
                child: Container(
                  width: 56, height: 56,
                  decoration: BoxDecoration(
                    color: running ? Colors.redAccent.withOpacity(0.2) : verdeNeon.withOpacity(0.2),
                    shape: BoxShape.circle,
                    border: Border.all(color: running ? Colors.redAccent : verdeNeon, width: 2)),
                  child: Icon(running ? Icons.pause : Icons.play_arrow,
                    color: running ? Colors.redAccent : verdeNeon, size: 32)))),
            const SizedBox(width: 16),
            // +1 min
            _btnControl("+1m", Colors.green, () => _ajustarTiempo(60)),
            const SizedBox(width: 10),
            // +5 min
            _btnControl("+5m", verdeNeon, () => _ajustarTiempo(300)),
          ]),
        if (sesionActual.puedeEditarAlgo) ...[
          const SizedBox(height: 16),
          // Terminar descanso
          OutlinedButton.icon(
            style: OutlinedButton.styleFrom(
              side: const BorderSide(color: Colors.amber),
              padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 10)),
            onPressed: () => TorneoTimerManager.cancelarDescanso(eventoId),
            icon: const Icon(Icons.skip_next, color: Colors.amber),
            label: const Text("TERMINAR DESCANSO",
              style: TextStyle(color: Colors.amber, fontWeight: FontWeight.w900, letterSpacing: 1))),
        ],
      ])));
  }

  Widget _btnControl(String label, Color color, VoidCallback onTap) =>
    GestureDetector(onTap: onTap,
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
        decoration: BoxDecoration(
          color: color.withOpacity(0.15),
          borderRadius: BorderRadius.circular(10),
          border: Border.all(color: color.withOpacity(0.5))),
        child: Text(label, style: TextStyle(color: color,
          fontWeight: FontWeight.w900, fontSize: 14))));
}
