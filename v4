class _DialogEstructuraNiveles extends StatefulWidget {
  final String eventoId;
  const _DialogEstructuraNiveles({required this.eventoId});
  @override State<_DialogEstructuraNiveles> createState() => _DENState();
}
class _DENState extends State<_DialogEstructuraNiveles> {
  List<Map<String, dynamic>> _niveles = [];
  bool _loading = true;
  int  _durMinutos = 20;

  @override void initState() { super.initState(); _cargar(); }

  Future<void> _cargar() async {
    final doc  = await FirebaseFirestore.instance.collection('eventos').doc(widget.eventoId).get();
    final data = doc.data() as Map<String, dynamic>? ?? {};
    final List raw = data['estructura_niveles'] ?? [];
    _durMinutos = (data['torneo_duration'] ?? 1200) ~/ 60;
    setState(() {
      _niveles = raw.isEmpty
        ? List.generate(8, (i) => {
            'nivel': i + 1,
            'sb':    (25 * math.pow(2, i)).toInt(),
            'bb':    (50 * math.pow(2, i)).toInt(),
            'ante':  i >= 3 ? (10 * math.pow(2, i - 2)).toInt() : 0,
          })
        : List<Map<String, dynamic>>.from(raw.map((e) => Map<String, dynamic>.from(e as Map)));
      _loading = false;
    });
  }

  Future<void> _guardar() async {
    await FirebaseFirestore.instance.collection('eventos').doc(widget.eventoId)
        .set({'estructura_niveles': _niveles,
          'torneo_duration': _durMinutos * 60,
          'torneo_duracion_ronda': _durMinutos * 60},
          SetOptions(merge: true));
    if (mounted) Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) => AlertDialog(
    backgroundColor: fondoCard,
    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15),
      side: const BorderSide(color: Colors.amber, width: 2)),
    title: const Text("?? Estructura de Niveles",
      style: TextStyle(color: Colors.amber, fontWeight: FontWeight.w900)),
    content: SizedBox(width: double.maxFinite, height: 420,
      child: _loading
        ? const Center(child: CircularProgressIndicator(color: verdeNeon))
        : Column(children: [
            Row(children: [
              const Text("Duración por nivel: ",
                style: TextStyle(color: turquesaTema, fontWeight: FontWeight.bold)),
              SizedBox(width: 55, child: TextFormField(
                initialValue: _durMinutos.toString(),
                keyboardType: TextInputType.number,
                style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold),
                decoration: const InputDecoration(isDense: true, filled: true, fillColor: Colors.black26),
                onChanged: (v) => _durMinutos = int.tryParse(v) ?? _durMinutos)),
              const Text(" min", style: TextStyle(color: naranjaTema)),
            ]),
            const SizedBox(height: 8),
            Row(children: const [
              SizedBox(width: 32, child: Text("Nv", textAlign: TextAlign.center,
                style: TextStyle(color: turquesaTema, fontWeight: FontWeight.bold, fontSize: 11))),
              Expanded(child: Text("CP", textAlign: TextAlign.center,
                style: TextStyle(color: turquesaTema, fontWeight: FontWeight.bold, fontSize: 11))),
              Expanded(child: Text("CG", textAlign: TextAlign.center,
                style: TextStyle(color: turquesaTema, fontWeight: FontWeight.bold, fontSize: 11))),
              Expanded(child: Text("Ante", textAlign: TextAlign.center,
                style: TextStyle(color: turquesaTema, fontWeight: FontWeight.bold, fontSize: 11))),
            ]),
            const Divider(color: Colors.white24),
            Expanded(child: ListView.builder(
              itemCount: _niveles.length,
              itemBuilder: (_, i) {
                final n = _niveles[i];
                return Padding(padding: const EdgeInsets.symmetric(vertical: 3),
                  child: Row(children: [
                    SizedBox(width: 32, child: Text("${n['nivel']}", textAlign: TextAlign.center,
                      style: const TextStyle(color: verdeNeon, fontWeight: FontWeight.w900, fontSize: 13))),
                    Expanded(child: _celda(n['sb'].toString(),
                      (v) => setState(() => _niveles[i]['sb'] = int.tryParse(v) ?? n['sb']))),
                    Expanded(child: _celda(n['bb'].toString(),
                      (v) => setState(() => _niveles[i]['bb'] = int.tryParse(v) ?? n['bb']))),
                    Expanded(child: _celda(n['ante'].toString(),
                      (v) => setState(() => _niveles[i]['ante'] = int.tryParse(v) ?? n['ante']))),
                  ]));
              })),
            Row(mainAxisAlignment: MainAxisAlignment.center, children: [
              TextButton.icon(
                onPressed: () => setState(() {
                  final last = _niveles.last;
                  _niveles.add({'nivel': _niveles.length + 1,
                    'sb': (last['sb'] as int) * 2, 'bb': (last['bb'] as int) * 2,
                    'ante': (last['ante'] as int) > 0 ? (last['ante'] as int) * 2 : 0});
