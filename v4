class _DialogNuevaJornada extends StatefulWidget {
  final Future<void> Function(_Jornada) onCrear;
  const _DialogNuevaJornada({required this.onCrear});
  @override State<_DialogNuevaJornada> createState() => _DialogNuevaJornadaState();
}
class _DialogNuevaJornadaState extends State<_DialogNuevaJornada> {
  List<QueryDocumentSnapshot> _plantillas = [];
  String? _selId;
  bool _cargando = true;

  @override
  void initState() { super.initState(); _cargarPlantillas(); }

  Future<void> _cargarPlantillas() async {
    final snap = await FirebaseFirestore.instance
        .collection('plantillas_caja').orderBy('creado', descending: false).get();
    setState(() { _plantillas = snap.docs; _cargando = false; });
  }

  Future<void> _guardarPlantilla(BuildContext ctx) async {
    final nC = TextEditingController();
    final s1C = TextEditingController(text: 'Jaime');
    final s2C = TextEditingController(text: 'Jorge');
    int numStaff = 4;
    showDialog(context: ctx, builder: (ctx2) =>
      StatefulBuilder(builder: (ctx2, setM2) => AlertDialog(
        backgroundColor: fondoCard,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15),
          side: const BorderSide(color: verdeNeon, width: 2)),
        title: const Text("Guardar Plantilla",
          style: TextStyle(color: verdeNeon, fontWeight: FontWeight.w900)),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          TextField(controller: nC,
            style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold),
            decoration: const InputDecoration(labelText: "Nombre de la plantilla",
              labelStyle: TextStyle(color: turquesaTema))),
          const SizedBox(height: 8),
          Row(children: [
            Expanded(child: TextField(controller: s1C,
              style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold),
              decoration: const InputDecoration(labelText: "Socio 1",
                labelStyle: TextStyle(color: Colors.white54)))),
            const SizedBox(width: 8),
            Expanded(child: TextField(controller: s2C,
              style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold),
              decoration: const InputDecoration(labelText: "Socio 2",
                labelStyle: TextStyle(color: Colors.white54)))),
          ]),
          const SizedBox(height: 8),
          Row(children: [
            const Text("Miembros de staff: ", style: TextStyle(color: Colors.white54, fontSize: 12)),
            Expanded(child: Slider(value: numStaff.toDouble(), min: 1, max: 10,
              divisions: 9, label: numStaff.toString(), activeColor: verdeNeon,
              onChanged: (v) => setM2(() => numStaff = v.toInt()))),
            Text("$numStaff", style: const TextStyle(color: verdeNeon, fontWeight: FontWeight.w900)),
          ]),
        ]),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx2),
            child: const Text("CANCELAR", style: TextStyle(color: Colors.grey))),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: verdeNeon),
            onPressed: () async {
              if (nC.text.trim().isEmpty) return;
              final staff = List.generate(numStaff, (_) => {
                'nombre': '', 'hEntrada': '', 'hSalida': '',
                'propinas': 0.0, 'jornada': 0.0, 'hExtras': 0.0,
                'subtotal': 0.0, 'abono': 0.0, 'porPagar': 0.0});
              await FirebaseFirestore.instance.collection('plantillas_caja').add({
                'nombre': nC.text.trim(),
                'socio1': s1C.text.trim().isEmpty ? 'Socio 1' : s1C.text.trim(),
                'socio2': s2C.text.trim().isEmpty ? 'Socio 2' : s2C.text.trim(),
                'staff': staff,
                'insumos': List.generate(3, (_) => {'detalle': '', 'valor': 0.0, 'factura': false}),
                'creado': FieldValue.serverTimestamp(),
              });
              if (ctx2.mounted) Navigator.pop(ctx2);
              await _cargarPlantillas();
            },
            child: const Text("GUARDAR",
              style: TextStyle(color: Colors.black, fontWeight: FontWeight.w900))),
        ])));
  }

  @override
  Widget build(BuildContext context) => AlertDialog(
    backgroundColor: fondoCard,
    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(15),
      side: const BorderSide(color: verdeNeon, width: 2)),
    title: Row(children: [
      const Expanded(child: Text("Nueva Jornada",
        style: TextStyle(color: verdeNeon, fontWeight: FontWeight.w900))),
      IconButton(icon: const Icon(Icons.add_circle_outline, color: turquesaTema),
        tooltip: "Nueva plantilla",
        onPressed: () => _guardarPlantilla(context)),
    ]),
    content: _cargando
      ? const Center(child: CircularProgressIndicator(color: verdeNeon))
      : SizedBox(width: double.maxFinite,
          child: _plantillas.isEmpty
            ? Column(mainAxisSize: MainAxisSize.min, children: [
                const Icon(Icons.folder_open, color: Colors.white24, size: 48),
                const SizedBox(height: 12),
                const Text("Sin plantillas guardadas.",
                  style: TextStyle(color: Colors.white54), textAlign: TextAlign.center),
                const SizedBox(height: 4),
                const Text("Toca + arriba para crear una.",
                  style: TextStyle(color: Colors.white38, fontSize: 12), textAlign: TextAlign.center),
              ])
            : ListView.builder(
                shrinkWrap: true,
                itemCount: _plantillas.length,
                itemBuilder: (_, i) {
                  final doc  = _plantillas[i];
                  final data = doc.data() as Map<String, dynamic>;
                  final sel  = _selId == doc.id;
                  return Card(
                    color: sel ? verdeNeon.withOpacity(0.15) : Colors.black26,
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10),
                      side: BorderSide(color: sel ? verdeNeon : Colors.white12, width: sel ? 2 : 1)),
                    child: ListTile(
                      title: Text(data['nombre']?.toString() ?? 'Plantilla',
                        style: TextStyle(color: sel ? verdeNeon : naranjaTema,
                          fontWeight: FontWeight.w800)),
                      subtitle: Text("${data['socio1'] ?? ''} + ${data['socio2'] ?? ''} · "
                        "${(data['staff'] as List?)?.length ?? 0} staff",
                        style: const TextStyle(color: Colors.white54, fontSize: 11)),
                      leading: Icon(Icons.description,
                        color: sel ? verdeNeon : Colors.white38),
                      trailing: IconButton(
                        icon: const Icon(Icons.delete, color: Colors.redAccent, size: 18),
                        onPressed: () async {
                          await doc.reference.delete();
                          await _cargarPlantillas();
                          if (_selId == doc.id) setState(() => _selId = null);
                        }),
                      onTap: () => setState(() => _selId = doc.id),
                    ));
                })),
    actions: [
      TextButton(onPressed: () => Navigator.pop(context),
        child: const Text("CANCELAR", style: TextStyle(color: Colors.grey))),
      ElevatedButton(
        style: ElevatedButton.styleFrom(
          backgroundColor: _selId != null ? verdeNeon : Colors.grey),
        onPressed: _selId == null ? null : () async {
          final doc  = _plantillas.firstWhere((d) => d.id == _selId);
          final data = doc.data() as Map<String, dynamic>;
          final staff = List<Map<String, dynamic>>.from(
            (data['staff'] ?? []).map((e) => Map<String, dynamic>.from(e as Map)));
          final insumos = List<Map<String, dynamic>>.from(
            (data['insumos'] ?? []).map((e) => Map<String, dynamic>.from(e as Map)));
          final jornada = _Jornada(
            tipo: 'custom',
            socio1nombre: data['socio1']?.toString() ?? 'Socio 1',
            socio2nombre: data['socio2']?.toString() ?? 'Socio 2',
            staff: staff,
            insumos: insumos.isEmpty
              ? List.generate(3, (_) => {'detalle': '', 'valor': 0.0, 'factura': false})
              : insumos,
          );
          Navigator.pop(context);
          await widget.onCrear(jornada);
        },
        child: const Text("CREAR",
          style: TextStyle(color: Colors.black, fontWeight: FontWeight.w900))),
    ]);
}

