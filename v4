// CAJA SCREEN — Cierre de Jornada (basado en plantilla Excel)
// Secciones: Fichas, Cuadre, Resumen, Insumos, Staff, Balance, Bancos
// ----------------------------------------------------------------

// -- Modelo de jornada -----------------------------------------
class _Jornada {
  String fecha;
  String tipo; // 'viernes', 'sabado', 'rafael'

  // Fichas inicio (denominación ? cantidad)
  Map<String, int> fichasInicio;
  // Fichas cierre
  Map<String, int> fichasCierre;

  // Cuadre de fichas
  int entregadas, recibidas, casilla, propinas, bonos, diferencia;
  // Bar por mesa
  Map<String, double> barMesa; // 'mesa1','mesa2','mesa3','bar','otros'

  // Resumen
  double casillaMesa1, casillaMesa2, casillaMesa3, barResumen, otrosResumen;
  double bonosJornada;
  double evento1, evento2, evento3;

  // Insumos
  List<Map<String, dynamic>> insumos; // {detalle, valor, factura}

  // Staff
  List<Map<String, dynamic>> staff;
  // {nombre, hEntrada, hSalida, propinas, jornada, hExtras, subtotal, abono, porPagar}

  // Balance cuentas por cobrar/pagar
  String socio1nombre, socio2nombre;
  Map<String, dynamic> balance1, balance2;
  // {super, prestamo, sesion, ctasCobrar, tabacos, pendientes, otros1, otros2, aRepartir}

  // Bancos
  Map<String, double> bancos1, bancos2;

  // Efectivo
  List<Map<String, dynamic>> efectivo;

  _Jornada({
    this.fecha = '',
    this.tipo = 'viernes',
    Map<String, int>? fichasInicio,
    Map<String, int>? fichasCierre,
    this.entregadas = 0, this.recibidas = 0, this.casilla = 0,
    this.propinas = 0, this.bonos = 0, this.diferencia = 0,
    Map<String, double>? barMesa,
    this.casillaMesa1 = 0, this.casillaMesa2 = 0, this.casillaMesa3 = 0,
    this.barResumen = 0, this.otrosResumen = 0,
    this.bonosJornada = 0, this.evento1 = 0, this.evento2 = 0, this.evento3 = 0,
    List<Map<String, dynamic>>? insumos,
    List<Map<String, dynamic>>? staff,
    this.socio1nombre = 'Jaime', this.socio2nombre = 'Jorge',
    Map<String, dynamic>? balance1, Map<String, dynamic>? balance2,
    Map<String, double>? bancos1, Map<String, double>? bancos2,
    List<Map<String, dynamic>>? efectivo,
  })  : fichasInicio = fichasInicio ?? {'100': 0, '25': 0, '5': 0, '1': 0},
        fichasCierre = fichasCierre ?? {'100': 0, '25': 0, '5': 0, '1': 0},
        barMesa = barMesa ?? {'mesa1': 0, 'mesa2': 0, 'mesa3': 0, 'bar': 0, 'otros': 0},
        insumos = insumos ?? [],
        staff = staff ?? [],
        balance1 = balance1 ?? {'super': 0.0, 'prestamo': 0.0, 'sesion': 0.0, 'ctasCobrar': 0.0,
          'tabacos': 0.0, 'pendientes': 0.0, 'otros1': 0.0, 'otros2': 0.0, 'aRepartir': 0.0},
        balance2 = balance2 ?? {'super': 0.0, 'prestamo': 0.0, 'sesion': 0.0, 'ctasCobrar': 0.0,
          'tabacos': 0.0, 'pendientes': 0.0, 'otros1': 0.0, 'otros2': 0.0, 'aRepartir': 0.0},
        bancos1 = bancos1 ?? {},
        bancos2 = bancos2 ?? {},
        efectivo = efectivo ?? [];

  // Cálculos automáticos
  int get totalFichasInicio =>
      (fichasInicio['100']! * 100) + (fichasInicio['25']! * 25) +
      (fichasInicio['5']! * 5) + (fichasInicio['1']! * 1);
  int get totalFichasCierre =>
      (fichasCierre['100']! * 100) + (fichasCierre['25']! * 25) +
      (fichasCierre['5']! * 5) + (fichasCierre['1']! * 1);
  double get subtotalIngresos =>
      casillaMesa1 + casillaMesa2 + casillaMesa3 + barResumen + otrosResumen;
  double get totalInsumos => insumos.fold(0.0, (s, i) => s + ((i['valor'] ?? 0) as num).toDouble());
  double get totalStaff => staff.fold(0.0, (s, e) => s + ((e['subtotal'] ?? 0) as num).toDouble());
  double get subtotalEgresos => bonosJornada + totalStaff + totalInsumos;
  double get totalRentabilidad => subtotalIngresos - subtotalEgresos;
  double get preliminar => totalRentabilidad - evento1 - evento2 - evento3;

  Map<String, dynamic> toMap() => {
    'fecha': fecha, 'tipo': tipo,
    'fichasInicio': fichasInicio, 'fichasCierre': fichasCierre,
    'entregadas': entregadas, 'recibidas': recibidas, 'casilla': casilla,
    'propinas': propinas, 'bonos': bonos, 'diferencia': diferencia,
    'barMesa': barMesa,
    'casillaMesa1': casillaMesa1, 'casillaMesa2': casillaMesa2, 'casillaMesa3': casillaMesa3,
    'barResumen': barResumen, 'otrosResumen': otrosResumen,
    'bonosJornada': bonosJornada, 'evento1': evento1, 'evento2': evento2, 'evento3': evento3,
