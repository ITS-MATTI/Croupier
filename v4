                  Row(mainAxisSize: MainAxisSize.min, children: [
                    const FichaPokerIcon(color: Colors.white70, size: 12),
                    const SizedBox(width: 3),
                    Text("${j['fichas']}", style: const TextStyle(color: Colors.white,
                      fontSize: 12, fontWeight: FontWeight.w900)),
                  ]),
                ]));
            });
        })),
